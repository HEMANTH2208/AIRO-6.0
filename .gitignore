# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
*.spec.ts
*.test.ts

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
.cache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# local env files - CRITICAL: Never commit these!
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Keep example env file for reference
!.env.example

# databases - Don't commit database files
/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/*.db
/prisma/*.db-journal
/prisma/dev.db*
prisma/dev.db
prisma/dev.db-journal

# Prisma
/lib/generated/prisma
prisma/migrations/*_migration/
node_modules/.prisma

# vercel
.vercel
.vercel.json

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE - editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode-test

# OS
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

