# ============================================
# AIRO 6.0 - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control
# ============================================

# Database Connection - Supabase PostgreSQL
# Get from: Supabase Dashboard → Project Settings → Database → Connection String
# Format: postgresql://postgres.[project-ref]:[password]@[region].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Direct URL for migrations (Transaction Mode)
# Get from: Supabase Dashboard → Project Settings → Database → Connection String (Direct)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres"

# Admin Credentials
# Change these to secure values in production
ADMIN_EMAIL="admin@airo6.com"
ADMIN_PASSWORD="Admin@AIRO6"

# JWT Secret
# Generate a secure random string for production
# Run: openssl rand -base64 32
JWT_SECRET="airo6-jwt-secret-change-in-production-min-32-chars"

# Application URL
# For local development:
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For production, use your Vercel URL:
NEXT_PUBLIC_APP_URL="https://your-app-name.vercel.app"

# ============================================
# Production Database Options
# ============================================

# Option 1: Vercel Postgres (Recommended)
# Automatically set when you create Vercel Postgres
# DATABASE_URL will be provided by Vercel

# Option 2: Supabase
# Get from: Project Settings → Database → Connection String
# DATABASE_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# Option 3: PlanetScale (MySQL)
# Get from: Dashboard → Connect → Prisma
# DATABASE_URL="mysql://[username]:[password]@[host]/[database]?sslaccept=strict"

# Option 4: Railway
# Get from: Project → PostgreSQL → Connect → Connection URL
# DATABASE_URL="postgresql://postgres:[password]@[host]:5432/railway"

# ============================================
# Optional Environment Variables
# ============================================

# Email Configuration (Future)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# NEXT_PUBLIC_VERCEL_ANALYTICS="1"

# Sentry Error Tracking (Optional)
# SENTRY_DSN="https://your-sentry-dsn"

# Rate Limiting (Optional)
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW="15m"

# ============================================
# Development vs Production
# ============================================

# NODE_ENV is automatically set by Vercel
# development | production | test
# NODE_ENV="development"

# ============================================
# Important Notes:
# ============================================
# 1. Never commit .env file to version control
# 2. Always use strong passwords in production
# 3. Generate secure JWT_SECRET (min 32 chars)
# 4. Use PostgreSQL for production (not SQLite)
# 5. Keep .env.example updated but without real values
# 6. Add all variables to Vercel Dashboard
# ============================================
